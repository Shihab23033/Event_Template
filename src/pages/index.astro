---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Gallery from '../components/sections/Gallery.astro';
import { sanityClient } from '../lib/sanity';

// 1. Fetch document (Update "eventData" to "siteSettings" if that's what your schema uses)
const query = `*[_type == "eventData" || _type == "siteSettings"] | order(_updatedAt desc)[0]`;
const event = await sanityClient.fetch(query);

// Debug Log: Check your terminal output to verify what Sanity returned!
console.log("Fetched Sanity Event Data:", event);

if (!event) {
  return Astro.redirect('/404');
}

// Map the theme field from Sanity (supports either theme or themeColor)
const selectedTheme = event.theme || event.themeColor || 'gold';
---

<BaseLayout 
  title={event.title || "Memory Album"} 
  theme={selectedTheme}
>
  <Hero 
    title={event.title} 
    eventDateTime={event.eventDateTime} 
    heroDisplayDate={event.heroDisplayDate} 
    heroImage={event.heroImage}
    welcomeText={event.welcomeText}
  />
  
  {event.gallery && <Gallery images={event.gallery} />}
</BaseLayout>