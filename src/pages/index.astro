---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Gallery from '../components/sections/Gallery.astro';
import { sanityClient } from '../lib/sanity';

// GROQ Query fetching all essential settings and gallery images
const query = `*[_type == "eventData"] | order(_updatedAt desc)[0]`;
const event = await sanityClient.fetch(query);

if (!event) {
  return Astro.redirect('/404'); // Handle case where no data exists
}
---

<BaseLayout 
  title={event.title || "Memory Album"} 
  themeColor={event.themeColor} 
  fontStyle={event.fontStyle}
>
  <Hero 
    title={event.title} 
    eventDateTime={event.eventDateTime} // Precise datetime for calculation
    heroDisplayDate={event.heroDisplayDate} // Human date to show
    heroImage={event.heroImage}
    welcomeText={event.welcomeText}
  />
  
  {event.gallery && <Gallery images={event.gallery} />}
</BaseLayout>