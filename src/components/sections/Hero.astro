---
// The component expects these details to be passed to it
const { title, subtitle, date } = Astro.props;
---

<section 
  style="background-color: var(--theme-primary);" 
  class="py-24 flex flex-col items-center justify-center text-white text-center p-6"
>
  <h1 class="text-5xl md:text-7xl font-bold mb-4">{title}</h1>
  {subtitle && <p class="text-2xl md:text-3xl mb-8">{subtitle}</p>}
  <div class="inline-block border border-white/50 px-6 py-3 rounded-full backdrop-blur-sm">
    <p class="text-lg uppercase tracking-widest">{date}</p>
  </div>
</section>
