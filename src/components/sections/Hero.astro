---
import Countdown from '../ui/Countdown.astro';
import { urlFor } from '../../lib/image';

interface Props {
  title?: string;
  welcomeText?: string;
  eventDateTime?: string;
  heroDisplayDate?: string;
  heroImage?: any;
}

const {
  title = "Shihab & Sumaiya",
  welcomeText = "Welcome to our Wedding",
  eventDateTime = "2026-10-24T18:00:00",
  heroDisplayDate = "October 24, 2026",
  heroImage
} = Astro.props;

// Safe URL builder check
let imageUrl: string | null = null;
if (heroImage && (heroImage.asset || heroImage._ref)) {
  try {
    imageUrl = urlFor(heroImage).width(1920).height(1080).quality(90).url();
  } catch (err) {
    console.warn("Could not parse heroImage URL:", err);
  }
}
---

<section class="relative min-h-[90vh] flex flex-col justify-center items-center text-center px-4 py-20 overflow-hidden bg-background text-text transition-colors duration-normal">
  
  {/* Hero Background Image with Theme-Synced Overlay */}
  {imageUrl && (
    <div class="absolute inset-0 z-0">
      <img 
        src={imageUrl} 
        alt={title} 
        class="w-full h-full object-cover opacity-90 transition-opacity duration-300"
      />
      {/* 
        Theme Gradient Overlay:
        Blends seamlessly into the active theme's background color 
        (Gold, Midnight, Rose, or Emerald) from top and bottom.
      */}
      <div class="absolute inset-0 bg-linear-to-b from-background/10 via-background/50 to-background/70 z-1"></div>
    </div>
  )}

  {/* Content Layer Synced with Theme Colors & Typography */}
  <div class="relative z-10 max-w-4xl mx-auto space-y-6 sm:space-y-8 animate-fade-in">
    
    {/* Display Date — Synced with Theme Accent Color */}
    {heroDisplayDate && (
      <p class="text-xs sm:text-sm tracking-[0.35em] uppercase text-accent font-semibold">
        {heroDisplayDate}
      </p>
    )}

    {/* Main Title — Synced with Theme Primary Color & Serif Font Token */}
    <h1 class="text-5xl sm:text-7xl md:text-8xl font-serif font-bold text-primary tracking-tight leading-tight">
      {title}
    </h1>

    {/* Welcome Text — Synced with Theme Muted Color */}
    {welcomeText && (
      <p class="text-lg sm:text-xl md:text-2xl text-muted font-light max-w-2xl mx-auto leading-relaxed">
        {welcomeText}
      </p>
    )}

    {/* Countdown Component */}
    <div class="pt-4 sm:pt-6">
      <Countdown targetDate={eventDateTime} />
    </div>

  </div>
</section>