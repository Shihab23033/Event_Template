---
import "../styles/global.css";

const {
  title = "Event Template",
  themeColor = "#000000",
  themeFont = "sans-serif",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body style={`--theme-primary: ${themeColor}; font-family: ${themeFont};`}>

    {/* The <slot /> tells Astro where to render Hero, Gallery, and all child components */}
    <slot />

  </body>
</html>