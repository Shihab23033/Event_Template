---
import '../styles/global.css';
import type { Theme } from '../config/themes';

interface Props {
  title?: string;
  theme?: Theme;
}

const { 
  title = "Event Framework", 
  theme = 'gold' 
} = Astro.props;

// Dynamically load theme variables
if (theme === 'gold') await import('../styles/themes/gold.css');
if (theme === 'midnight') await import('../styles/themes/midnight.css');
if (theme === 'rose') await import('../styles/themes/rose.css');
if (theme === 'emerald') await import('../styles/themes/emerald.css');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-text transition-colors duration-normal antialiased min-h-screen">
    <slot />
  </body>
</html>